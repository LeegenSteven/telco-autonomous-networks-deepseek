# DeepSeek API configuration. Never commit a real API key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# Local runtime configuration. Relative paths are resolved from agents/.
LOCAL_DB_PATH=../.local/telco_demo.duckdb
LOCAL_LOG_PATH=../.local/logs/agent_events.jsonl
EXTERNAL_DOCS_ENABLED=false

# Optional per-agent overrides.
# INCIDENT_DETECTOR_MODEL=deepseek-v4-flash
# ROOT_AGENT_MODEL=deepseek-v4-pro
# ANALYZER_MODEL=deepseek-v4-pro
# REPORT_GENERATOR_MODEL=deepseek-v4-pro
